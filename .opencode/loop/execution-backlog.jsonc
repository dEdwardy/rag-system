    "excluded": [
      "SaaS / enterprise capability expansion",
      "multi-tenant expansion beyond current owner-only baseline",
      "mobile adaptation / mobile UI work",
      "new source family expansion",
      "broad dashboard platformization",
      "broad UI redesign"
    ]
  },
  "priorityOrder": [
    "P3",
    "P5",
    "P6",
    "P4"
  ],
  "statusBuckets": {
