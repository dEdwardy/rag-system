      ],
      "goal": "Create a layered annotation spec where every question has answer expectations and only key questions add grounded evidence expectations.",
      "scope": [
        "evaluation annotation manifest"
      ],
      "decision": {
        "defaultLayer": [
          "question intent",
          "expected answer points",
          "must-not-miss points",
          "acceptable expression range"
        ],
        "criticalQuestionLayer": [
          "expected citation/document evidence type",
          "minimum fact class that must be cited",
          "evidence-missing failure condition"
        ],
        "annotationBias": "Do not require full evidence markup on every question in v1; add evidence requirements only to the smaller critical subset."
      },
      "acceptance": [
        "Each selected baseline question has an approved default-layer expectation record.",
        "A smaller critical subset additionally defines grounded evidence expectations.",
        "The annotation workload remains light enough to maintain during early loop-driven iteration."
      ],
      "verification": [
        "human review"
      ],
      "notDoing": [
        "No new evaluation framework"
      ],
      "suspendWhen": [
