  "version": 1,
  "updatedAt": "2026-03-30T00:00:00.000Z",
  "scope": {
    "productStage": "local-first RAG hardening / feature closeout",
    "included": [
      "apps/api",
      "apps/web (PC Web only)",
      "packages/shared",
      "docs",
      ".opencode/loop"
