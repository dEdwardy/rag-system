      "phase": "P3",
      "title": "add legality and crawl-safety guardrails around existing external-source ingestion",
      "priority": "high",
      "status": "auto_now",
      "autoExecutable": true,
      "humanInputRequired": false,
      "dependsOn": [],
      "goal": "Keep existing web/feed/sitemap ingestion legally safer and less disruptive through a narrow policy baseline (public/no-login/no-paywall only, no access-control bypass, sitemap/sitemapindex as URL index-not-authorization-grant, user-side rights-to-use responsibility), then apply robots/domain courtesy, crawl budgets, breaker behavior, and incremental resync bias without opening new source families.",
      "scope": [
        "apps/api/src/infra/http/fetch-with-retry.ts",
        "apps/api/src/infra/web-page/web-page.service.ts",
        "apps/api/src/infra/feed-source/feed-source.service.ts",
        "apps/api/src/infra/sitemap-source/sitemap-source.service.ts",
