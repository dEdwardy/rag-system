# OpenAI API配置（RAGAS需要）
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# RAG系统API配置
RAG_API_URL=http://localhost:3000
RAG_USER_ID=default-user  # 可选，用于dev模式登录

# 评估配置
RAGAS_METRICS=answer_relevance,faithfulness,context_precision,context_recall
OUTPUT_DIR=./reports

# 调试配置
DEBUG=false
LOG_LEVEL=INFO