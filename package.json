{
  "name": "rag-system",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev:web": "pnpm --filter @rag-system/web dev",
    "dev:api": "pnpm --filter @rag-system/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:api": "pnpm --filter @rag-system/api build && node --test --test-concurrency=1 apps/api/test/*.test.js",
    "test:web-smoke": "pnpm --filter @rag-system/api build && pnpm --filter @rag-system/web build && node --test apps/web/test/pc-web-smoke.test.js"
  }
}
