{
  "name": "rag-system",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "prepare": "husky",
    "opencode:loop": "node .opencode/loop/harness/control.mjs",
    "loop:start": "node .opencode/loop/harness/control.mjs start",
    "loop:stop": "node .opencode/loop/harness/control.mjs stop",
    "loop:status": "node .opencode/loop/harness/control.mjs status",
    "check:encoding": "node scripts/check-encoding.mjs",
    "lint:fast": "oxlint apps packages scripts",
    "lint:ci": "pnpm --filter @rag-system/api lint && pnpm --filter @rag-system/web lint",
    "dev:web": "pnpm --filter @rag-system/web dev",
    "dev:api": "pnpm --filter @rag-system/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "typecheck:ci": "pnpm --filter @rag-system/api typecheck && pnpm --filter @rag-system/web typecheck",
    "test:api": "pnpm --filter @rag-system/api test:all",
    "test:api:fast:llm": "pnpm --filter @rag-system/api test:fast:llm",
    "test:api:fast:retrieval": "pnpm --filter @rag-system/api test:fast:retrieval",
    "test:api:fast:assistants": "pnpm --filter @rag-system/api test:fast:assistants",
    "test:api:fast:documents": "pnpm --filter @rag-system/api test:fast:documents",
    "test:api:fast:infra": "pnpm --filter @rag-system/api test:fast:infra",
    "test:api:fast": "pnpm --filter @rag-system/api test:fast",
    "test:api:file": "pnpm --filter @rag-system/api test:file",
    "test:api:integration": "pnpm --filter @rag-system/api test:integration",
    "test:api:focus:ask": "pnpm --filter @rag-system/api test:focus:ask",
    "test:api:focus:llm-retrieval": "pnpm --filter @rag-system/api test:focus:llm-retrieval",
    "test:api:focus:documents": "pnpm --filter @rag-system/api test:focus:documents",
    "test:api:focus:sources": "pnpm --filter @rag-system/api test:focus:sources",
    "test:api:focus:api-config": "pnpm --filter @rag-system/api test:focus:api-config",
    "test:api:focus:acl": "pnpm --filter @rag-system/api test:focus:acl",
    "test:api:e2e:chains": "pnpm --filter @rag-system/api test:e2e:chains",
    "test:api:e2e:sources": "pnpm --filter @rag-system/api test:e2e:sources",
    "test:api:e2e": "pnpm --filter @rag-system/api test:e2e",
    "test:web": "pnpm --filter @rag-system/web test:all",
    "test:web:guard": "pnpm --filter @rag-system/web test:guard",
    "test:web:guard:legacy": "pnpm --filter @rag-system/web test:guard:legacy",
    "test:web:legacy": "pnpm --filter @rag-system/web test:legacy",
    "test:web:smoke": "pnpm --filter @rag-system/web test:smoke:legacy",
    "test:web:smoke:legacy": "pnpm --filter @rag-system/web test:smoke:legacy",
    "test:web-smoke": "pnpm run test:web:smoke"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.59.0",
    "prettier": "^3.8.2"
  }
}
