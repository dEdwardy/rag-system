# API
API_PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_system

# Queue
QUEUE_PROVIDER=pgmq
QUEUE_PREFIX=rag-local
QUEUE_DATABASE_POLL_INTERVAL_MS=1000
QUEUE_DATABASE_RETRY_DELAY_MS=5000
QUEUE_DATABASE_MAX_ATTEMPTS=3
QUEUE_PGMQ_VISIBILITY_TIMEOUT_SECONDS=300

# LLM / Embedding
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_ANSWER_TEMPERATURE=0.2
LLM_REWRITE_TEMPERATURE=0

# Source fetch
SOURCE_FETCH_TIMEOUT_MS=10000
SOURCE_FETCH_RETRY_ATTEMPTS=2

# Auth
# session cookie 名称，服务端 session 仍然是可信会话状态来源
AUTH_SESSION_COOKIE_NAME=rag_session
# session 过期时间（小时）
AUTH_SESSION_TTL_HOURS=168
# access JWT 对应的 cookie 名称；普通请求优先只验它，不查库
AUTH_ACCESS_TOKEN_COOKIE_NAME=rag_access_token
# access JWT 有效期（分钟）；建议保持短时有效，过期后走 /auth/refresh
AUTH_ACCESS_JWT_TTL_MINUTES=15
# access JWT 签名密钥；生产环境必须显式配置强随机值
AUTH_ACCESS_JWT_SECRET=dev-access-jwt-secret
# auth cookie 是否带 Secure；本地 http 开发可设 false，生产应为 true
AUTH_COOKIE_SECURE=false
# auth cookie SameSite 策略；当前默认 Lax，跨站部署再考虑 None
AUTH_COOKIE_SAME_SITE=Lax
# refresh 接口限流窗口（毫秒）
AUTH_RATE_LIMIT_REFRESH_WINDOW_MS=60000
# refresh 接口限流次数上限
AUTH_RATE_LIMIT_REFRESH_MAX=30
# 本地默认用户模式开关，仅开发环境使用
AUTH_DEV_DEFAULT_USER_MODE=true

# Storage
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_UPLOADS=uploads
SUPABASE_STORAGE_BUCKET_GENERATED=generated

# Vector store
VECTOR_STORE_PROVIDER=filesystem
VECTOR_STORE_PGVECTOR_TABLE=ChunkEmbedding
VECTOR_STORE_PGVECTOR_DIMENSIONS=768
