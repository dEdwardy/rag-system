API_PORT=3000
NODE_ENV=production
REQUEST_TIMING_LOG_ENV=false

CORS_ORIGIN=https://your-domain.example

DATABASE_URL=postgresql://postgres:password@db.example.com:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.example.com:5432/postgres

QUEUE_PROVIDER=redis
QUEUE_PREFIX=rag-prod
QUEUE_DATABASE_POLL_INTERVAL_MS=1000
QUEUE_DATABASE_RETRY_DELAY_MS=5000
QUEUE_DATABASE_MAX_ATTEMPTS=3
QUEUE_PGMQ_VISIBILITY_TIMEOUT_SECONDS=300
QUEUE_MAX_CONCURRENT_TASKS=1
QUEUE_TASK_TIMEOUT_MS=300000
DOCUMENT_INGESTION_WORKER_ENABLED=true

STORAGE_PROVIDER=oss
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET=rag-system
OSS_PREFIX=rag-system
OSS_SECURITY_TOKEN=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET_UPLOADS=uploads
SUPABASE_STORAGE_BUCKET_GENERATED=generated

AUTH_ACCESS_JWT_SECRET=replace-with-a-long-random-secret
AUTH_DEFAULT_TENANT_ID=default-tenant
AUTH_SESSION_TTL_HOURS=168
AUTH_DEV_DEFAULT_USER_MODE=false
AUTH_ACCESS_JWT_TTL_MINUTES=15
AUTH_ACCESS_TOKEN_COOKIE_NAME=rag_access_token
AUTH_REFRESH_TOKEN_COOKIE_NAME=rag_refresh_token
AUTH_OAUTH_STATE_TTL_SECONDS=300
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax

AUTH_GITHUB_CLIENT_ID=your-github-client-id
AUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
AUTH_GITHUB_REDIRECT_URI=https://your-domain.example/ragora/api/auth/oauth/github/callback
AUTH_OAUTH_SUCCESS_REDIRECT_URI=https://your-domain.example/ragora/

VECTOR_STORE_PROVIDER=pgvector
VECTOR_STORE_PGVECTOR_TABLE=ChunkEmbedding
VECTOR_STORE_PGVECTOR_DIMENSIONS=1024

OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_EMBEDDING_API_MODE=default

OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_EMBEDDING_MODEL=
OLLAMA_EMBEDDING_DIMENSIONS=

LLM_ANSWER_TEMPERATURE=0.2
LLM_REWRITE_TEMPERATURE=0

AUTH_RATE_LIMIT_LOGIN_WINDOW_MS=60000
AUTH_RATE_LIMIT_LOGIN_MAX=5
AUTH_RATE_LIMIT_OAUTH_START_WINDOW_MS=60000
AUTH_RATE_LIMIT_OAUTH_START_MAX=10
AUTH_RATE_LIMIT_OAUTH_CALLBACK_WINDOW_MS=60000
AUTH_RATE_LIMIT_OAUTH_CALLBACK_MAX=10
AUTH_RATE_LIMIT_REFRESH_WINDOW_MS=60000
AUTH_RATE_LIMIT_REFRESH_MAX=30

# Optional and currently unused by the app:
REDIS_URL=redis://127.0.0.1:6379
