generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  inactive
}

enum UserStatus {
  active
  inactive
}

enum UserRole {
  owner
  member
}

enum KnowledgeBaseStatus {
  active
  inactive
}

enum AssistantStatus {
  active
  inactive
}

enum ConversationStatus {
  active
  archived
}

enum MessageRole {
  user
  assistant
}

enum TraceStatus {
  success
  failed
}

enum DocumentStatus {
  pending
  processing
  ready
  failed
}

enum DocumentProcessingStage {
  uploaded
  parsing
  chunking
  indexing
  completed
  failed
}

enum DocumentRunTrigger {
  upload
  reindex
  external_resync
}

enum DocumentRunStatus {
  pending
  processing
  ready
  failed
  skipped
}

enum DocumentRunFailedStage {
  source_fetch
  parsing
  chunking
  indexing
  stale_guard
}

enum EvalQuestionSetStatus {
  draft
  locked
  archived
}

model Tenant {
  id        String         @id @default(cuid())
  name      String
  status    TenantStatus   @default(active)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  users     User[]
  knowledgeBases KnowledgeBase[]
  retrievalProfiles RetrievalProfile[]
  assistants Assistant[]
  conversations Conversation[]
  evalQuestionSets EvalQuestionSet[]
  evalQuestionSetBaselineSnapshots EvalQuestionSetBaselineSnapshot[]
}

model User {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  displayName    String?
  email          String?         @unique
  passwordHash   String?
  role           UserRole        @default(owner)
  status         UserStatus      @default(active)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeBases KnowledgeBase[]
  retrievalProfiles RetrievalProfile[]
  conversations  Conversation[]
  authSessions   AuthSession[]
  authIdentityLinks AuthIdentityLink[]
  evalQuestionSets EvalQuestionSet[]
  evalQuestionSetBaselineSnapshots EvalQuestionSetBaselineSnapshot[]
}

model EvalQuestionSet {
  id               String                          @id @default(cuid())
  tenantId         String
  ownerId          String
  name             String
  description      String?
  questionsJson    Json
  currentVersion   Int                             @default(1)
  baselineSnapshotId String?
  baselineChosenAt DateTime?
  pinnedBaselineResultJson Json?
  pinnedBaselineCapturedAt DateTime?
  latestEvalResultSummaryJson Json?
  latestEvalRanAt DateTime?
  status           EvalQuestionSetStatus           @default(draft)
  lockedAt         DateTime?
  archivedAt       DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  tenant           Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner            User                            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  snapshots        EvalQuestionSetBaselineSnapshot[] @relation("EvalQuestionSetSnapshots")
  baselineSnapshot EvalQuestionSetBaselineSnapshot?  @relation("EvalQuestionSetChosenBaseline", fields: [baselineSnapshotId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([baselineSnapshotId])
}

model EvalQuestionSetBaselineSnapshot {
  id            String          @id @default(cuid())
  tenantId      String
  ownerId       String
  questionSetId String
  version       Int
  name          String
  description   String?
  questionsJson Json
  createdAt     DateTime        @default(now())
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questionSet   EvalQuestionSet @relation("EvalQuestionSetSnapshots", fields: [questionSetId], references: [id], onDelete: Cascade)
  chosenByQuestionSets EvalQuestionSet[] @relation("EvalQuestionSetChosenBaseline")

  @@unique([questionSetId, version])
  @@index([tenantId])
  @@index([ownerId])
  @@index([questionSetId])
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuthIdentityLink {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  subject   String
  emailSnapshot   String?
  profileSnapshot Json?
  lastLoginAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model KnowledgeBase {
  id          String               @id @default(cuid())
  tenantId    String
  ownerId     String
  name        String
  description String?
  status      KnowledgeBaseStatus  @default(active)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documents   Document[]
  assistants  Assistant[]
}

model Document {
  id              String                  @id @default(cuid())
  kbId            String
  sourceType      String
  sourceName      String
  title           String
  mimeType        String
  storageKey      String
  sourceConfigJson Json?
  status          DocumentStatus          @default(pending)
  processingStage DocumentProcessingStage @default(uploaded)
  version         Int                     @default(1)
  chunkCount      Int                     @default(0)
  errorMessage    String?
  diagnosticsJson Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  knowledgeBase   KnowledgeBase           @relation(fields: [kbId], references: [id], onDelete: Cascade)
  chunks          DocumentChunk[]
  runs            DocumentRun[]

  @@index([kbId])
  @@index([status])
}

model DocumentRun {
  id              String                @id @default(cuid())
  documentId      String
  version         Int
  trigger         DocumentRunTrigger
  status          DocumentRunStatus     @default(pending)
  failedStage     DocumentRunFailedStage?
  diagnosticsJson Json?
  startedAt       DateTime              @default(now())
  finishedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  document        Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
}

model DocumentChunk {
  id           String   @id @default(cuid())
  documentId   String
  kbId         String
  chunkIndex   Int
  content      String
  tokenCount   Int      @default(0)
  sectionTitle String?
  pageNo       Int?
  metadataJson Json?
  embeddingRef String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([kbId])
}

model ChunkEmbedding {
  id           String                    @id
  kbId         String
  documentId   String
  chunkId      String
  chunkIndex   Int
  sectionTitle String?
  pageNo       Int?
  content      String
  modelName    String
  dimensions   Int
  metadataJson Json?
  embedding    Unsupported("vector(1024)")
  updatedAt    DateTime

  @@index([kbId])
  @@index([documentId])
  @@index([kbId, modelName, dimensions])
}

model IngestionQueueJob {
  id              String   @id
  queueName       String
  jobKey          String
  documentId      String
  documentVersion Int?
  status          String   @default("pending")
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  availableAt     DateTime @default(now())
  lockedAt        DateTime?
  lastError       String?
  payloadJson     Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([queueName, jobKey])
  @@index([queueName, status, availableAt])
  @@index([documentId])
}

model RetrievalProfile {
  id             String      @id @default(cuid())
  tenantId       String
  ownerId        String
  name           String
  topK           Int         @default(3)
  chunkWindow    Int         @default(0)
  enableHybrid   Boolean     @default(false)
  enableRerank   Boolean     @default(false)
  scoreThreshold Float       @default(0)
  filtersJson    Json?
  strategyJson   Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner          User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assistants     Assistant[]

  @@index([tenantId])
  @@index([ownerId])
}

model Assistant {
  id                 String            @id @default(cuid())
  tenantId           String
  kbId               String
  name               String
  description        String?
  systemPrompt       String
  retrievalProfileId String
  answerPolicyJson   Json?
  status             AssistantStatus   @default(active)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeBase      KnowledgeBase     @relation(fields: [kbId], references: [id], onDelete: Cascade)
  retrievalProfile   RetrievalProfile  @relation(fields: [retrievalProfileId], references: [id], onDelete: Restrict)
  conversations      Conversation[]
  traces             AnswerTrace[]

  @@index([kbId])
  @@index([tenantId])
}

model Conversation {
  id          String             @id @default(cuid())
  tenantId    String
  userId      String
  assistantId String
  title       String
  status      ConversationStatus @default(active)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assistant   Assistant          @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  messages    Message[]
  traces      AnswerTrace[]

  @@index([assistantId])
  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  traceId        String?
  createdAt      DateTime    @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AnswerTrace {
  id                 String      @id @default(cuid())
  conversationId     String
  assistantId        String
  userMessageId      String?
  assistantMessageId String?
  userQuery          String
  rewrittenQuery     String?
  retrievedChunkIdsJson Json?
  retrievalScoresJson   Json?
  retrievalMetadataJson Json?
  citationsJson         Json?
  answeringMetadataJson Json?
  qualityEvaluationJson Json?
  modelName             String?
  latencyMs             Int?
  status                TraceStatus @default(success)
  errorMessage          String?
  createdAt             DateTime    @default(now())
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assistant             Assistant    @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([assistantId])
}
