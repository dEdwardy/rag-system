{
  "$schema": "https://opencode.ai/config.json",
  // Keep the backend OpenCode session focused on apps/api when started there.
  // Root sessions stay monorepo-wide; apps/web has its own frontend-local config.
  // Model split rationale (kept as-is):
  // - plan/review-risk keep gpt-5.4 for higher-stakes backend planning/risk checks.
  // - build keeps gpt-5.4 for the current proxy-backed implementation loops.
  // - explore keeps gpt-5.3-mini for low-cost scoped lookup and evidence gathering.
  "command": {
    "plan": {
      "agent": "rag-plan",
      "model": "openai/gpt-5.4",
      "description": "产出后端任务的最小可执行增量",
      "template": "先阅读 AGENTS.md、apps/api/AGENTS.md、docs/next_steps_rag_project_plan.md、docs/current-progress.md、docs/current-dev-setup.md、README.md。以后端正确性、retrieval / answering、ingestion、diagnostics 为优先，给出当前任务的最小计划。默认按 plan -> build 工作；若缺少对应 superpowers spec/plan，先补齐，再进入 build/实施。"
    },
    "build": {
      "agent": "rag-build",
      "model": "my/gpt-5.4",
      "description": "按已确认计划实施并完成最小验证",
      "template": "基于已确认的最小计划执行实现。优先 backend-first、小步增量、快验证；不做无关重构。高风险区域包括 ingestion、retrieval、answering/orchestration、streaming、persistence/schema 和 shared contracts。TDD 不是默认流程，仅在行为语义、共享契约、source recovery 等改动时启用 light TDD。"
    },
    "explore": {
      "agent": "rag-explore",
      "description": "窄范围代码与文档检索",
      "model": "openai/gpt-5.3-mini",
      "template": "只做窄范围代码与文档检索、定位、对比与证据整理；优先查看 apps/api/src、apps/api/prisma、apps/api/test 和 shared contracts；不要扩展为完整实现任务。"
    },
    "review-risk": {
      "agent": "rag-review",
      "model": "openai/gpt-5.4",
      "description": "仅用于高风险或合并前关键审查",
      "template": "只审查高风险变更，如 retrieval、fallback、answering、citation、ingestion、source sync/recovery、schema、orchestrator、shared contract、streaming、persistence；不要把 review 作为默认步骤；config/docs/style 小改不默认触发 review。"
    }
  }
}
